<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>FileDermaga — third-party licenses</title>
<style>
  body { font: 14px/1.5 system-ui, sans-serif; max-width: 960px; margin: 2em auto; padding: 0 1em; }
  pre { white-space: pre-wrap; background: #f5f5f5; padding: 1em; border-radius: 6px; font-size: 12px; }
  li.license { margin-bottom: 2em; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>FileDermaga is licensed under MIT OR Apache-2.0. It includes the following open source components.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}</ul>
<h2>License texts</h2>
<ul>
{{#each licenses}}<li class="license">
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>{{/each}}</ul>
<pre>{{text}}</pre>
</li>
{{/each}}</ul>
</body>
</html>
